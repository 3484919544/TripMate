    "pinia": "^2.1.6",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020620260914001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020620260914001",
